# ---------------------------------------------------------------------------
# Docker Compose top-level variables (used in docker-compose.yml interpolation)
# Copy to .env.compose and fill in. NEVER commit the filled-in file.
# ---------------------------------------------------------------------------

# RDS endpoint (without port)
RDS_HOST=edunexus-postgres.cc7y0cms2un6.us-east-1.rds.amazonaws.com

# Keycloak database credentials (CREATE USER keycloak_user WITH PASSWORD '...')
KC_DB_USER=keycloak_user
KC_DB_PASSWORD=<generate-strong-password>

# Keycloak admin console password
KC_ADMIN_PASSWORD=<generate-strong-password>

# Keycloak public hostname (the OIDC issuer domain)
KEYCLOAK_HOSTNAME=<auth.your-domain.com>
